# Port for the API and the approval app
PORT=3000
# Public URL of this server (used in push notification links)
PUBLIC_URL=http://localhost:3000
# Where the SQLite database lives
DATABASE_PATH=./data/wallet.db
# Card issuer: "mock" (default, fake test cards) or "lithic" (Lithic sandbox)
CARD_ISSUER=mock
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com
# Minutes before an unanswered approval request expires
APPROVAL_TIMEOUT_MINUTES=15
# Contact for web push (required by the push spec)
VAPID_SUBJECT=mailto:you@example.com
# Price checks before you approve: set SERPAPI_KEY for Google Shopping prices,
# or PRICE_CHECK=demo for made-up prices to try the feature
SERPAPI_KEY=
PRICE_CHECK=
