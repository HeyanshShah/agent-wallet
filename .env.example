# Hosted mode: anyone can sign up with an email and password and gets their own wallet.
# Leave at 0 for a private, single-person wallet (sign in with the owner token).
HOSTED=0
# Hosted mode: folder for control.db and one database per customer
DATA_DIR=./data
# Hosted mode: everything is free until this date (shown in the app). Empty = no date shown
FREE_UNTIL=
# Hosted mode: set to 0 to stop new sign-ups
SIGNUPS_OPEN=1
# Port for the API and the approval app
PORT=3000
# Public URL of this server (push links, Face ID, and the issuer of signed approvals)
PUBLIC_URL=http://localhost:3000
# Where the SQLite database lives
DATABASE_PATH=./data/wallet.db
# Card issuer: "mock" (default, fake test cards) or "lithic" (Lithic sandbox)
CARD_ISSUER=mock
LITHIC_API_KEY=
LITHIC_BASE_URL=https://sandbox.lithic.com
# Signing secret of your Lithic webhook (whsec_...). Turns on POST /webhooks/lithic so real charges are recorded
LITHIC_WEBHOOK_SECRET=
# Key that encrypts card details in the database: 64 hex characters or base64 of 32 bytes
# (openssl rand -hex 32). If empty, one is created in wallet.key next to the database. Keep a backup.
WALLET_ENCRYPTION_KEY=
# Minutes before an unanswered approval request expires
APPROVAL_TIMEOUT_MINUTES=15
# Contact for web push (required by the push spec)
VAPID_SUBJECT=mailto:you@example.com
# Price checks before you approve: set SERPAPI_KEY for Google Shopping prices,
# or PRICE_CHECK=demo for made-up prices to try the feature
SERPAPI_KEY=
PRICE_CHECK=
